[Unit]
Description=llama-dashboard
Documentation=https://github.com/rbonghi/jetson_stats
After=network.target

[Service]
Type=simple
# Run as a dedicated non-root user.
# That user must be a member of the group that owns /run/jtop.sock
# (typically "jtop"). Create with:
#   sudo useradd -r -s /sbin/nologin llama-dashboard
#   sudo usermod -aG jtop llama-dashboard
User=llama-dashboard
WorkingDirectory=/opt/llama-dashboard
ExecStart=/usr/bin/python3 /opt/llama-dashboard/app.py
Restart=always
RestartSec=5

# Harden slightly — no writes needed outside the working dir.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
